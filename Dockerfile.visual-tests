# syntax=docker/dockerfile:1

ARG PNPM_VERSION
ARG PLAYWRIGHT_VERSION

FROM ghcr.io/pnpm/pnpm:${PNPM_VERSION} AS dependencies

ARG PLAYWRIGHT_VERSION

WORKDIR /server

RUN --mount=type=cache,id=pit-display-playwright-pnpm,target=/pnpm/store \
	pnpm add --config.enable-global-virtual-store=false --save-exact playwright@${PLAYWRIGHT_VERSION}

FROM mcr.microsoft.com/playwright:v${PLAYWRIGHT_VERSION}-resolute

COPY --from=dependencies --chown=pwuser:pwuser /server/node_modules /server/node_modules

USER pwuser
WORKDIR /server

ENTRYPOINT ["node", "node_modules/playwright/cli.js", "run-server"]
CMD ["--port", "3000", "--host", "0.0.0.0"]
