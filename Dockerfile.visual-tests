FROM ghcr.io/pnpm/pnpm:12.4.1 AS pnpm

FROM mcr.microsoft.com/playwright:v1.63.0-noble

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME/bin:$PATH

COPY --from=pnpm /opt/pnpm/pnpm /usr/local/bin/pnpm

WORKDIR /work

ENTRYPOINT ["bash", "-lc", "pnpm install --frozen-lockfile && exec \"$@\"", "--"]
CMD ["pnpm", "exec", "vp", "test", "--project", "visual", "--reporter=default", "--reporter=html", "--outputFile.html=.vitest/html/index.html"]
