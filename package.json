{
	"name": "pit-display",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vp build && node scripts/build-pwa.ts && tsc -b",
		"deploy": "convex deploy --cmd 'vp run build' --cmd-url-env-var-name VITE_CONVEX_URL && wrangler deploy",
		"dev": "pnpm run \"/^dev:.*/\"",
		"dev:backend": "convex dev",
		"dev:frontend": "portless pit.frc581.com vp dev",
		"lint": "vp lint",
		"openapi-ts": "openapi-ts",
		"prepare": "vp config",
		"preview": "vp preview"
	},
	"dependencies": {
		"@convex-dev/react-query": "^0.1.0",
		"@fontsource-variable/source-sans-3": "5.3.0",
		"@hono/zod-openapi": "1.6.3",
		"@stylexjs/stylex": "0.19.0",
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-router": "^1.170.35",
		"@tanstack/react-router-ssr-query": "^1.167.2",
		"@tanstack/react-start": "^1.168.52",
		"convex": "^1.45.0",
		"convex-helpers": "0.1.124",
		"envalid": "8.2.0",
		"hono": "4.13.7",
		"lucide-react": "^1.45.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"temporal-polyfill": "^1.0.5",
		"torph": "0.1.3",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@hey-api/openapi-ts": "0.99.0",
		"@stylexjs/unplugin": "0.19.0",
		"@types/node": "24.13.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vite-pwa/assets-generator": "2.0.0",
		"@vitejs/plugin-react": "6.1.1",
		"knip": "6.35.1",
		"portless": "0.15.6",
		"typescript": "7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"workbox-build": "^7.4.1",
		"wrangler": "^4.130.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.x",
			"onFail": "warn"
		}
	},
	"packageManager": "pnpm@12.4.1"
}
