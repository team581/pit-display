amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

steps {
  ["vp-check"] = (Builtins.vp_check) {
    check = "vp check"
    fix = "vp check --fix"
  }
  ["knip"] = (Builtins.knip) {
    fix = null
    prefix = "vp exec"
  }
  ["playwright-daemon"] {
    check = "pitchfork start playwright"
  }
  ["visual-snapshots"] {
    check = "vp run test:visual"
    fix = "vp run test:visual:update"
    stage = "src/testing/__screenshots__/**"
    depends = "playwright-daemon"
    exclusive = true
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stage = true
    stash = "git"
  }
}
